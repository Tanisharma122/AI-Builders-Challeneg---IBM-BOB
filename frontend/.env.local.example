# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local.example
# Copy this file to frontend/.env.local and fill in your values.
# NEVER commit .env.local — it contains real API keys.
# ─────────────────────────────────────────────────────────────────────────────

# FastAPI backend URL (local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Gemini API (for text-to-image prompt enhancement + thumbnail generation) ──
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_backup_here

# ── HuggingFace Token (for FLUX.1-schnell image generation via HF Router) ─────
# Get at: https://huggingface.co/settings/tokens (Read role is enough)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
